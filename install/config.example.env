# ==============================================================================
# Cymbal Retail Agentic Commerce demo (English edition) — installer configuration
# ==============================================================================
# Usage:
#   cp install/config.example.env install/config.env
#   vi install/config.env        # set PROJECT_ID
#   ./install/install.sh
#
# install/config.env is git-ignored. Never put credentials or secrets in it.
# Everything else (project number, Cloud Run URLs, bucket names, service-account e-mail) is derived at install time.
# ==============================================================================

# [required] Target Google Cloud project id (billing must be enabled)
PROJECT_ID=""

# [optional] Region for Cloud Run, BigQuery and Cloud Storage
REGION="asia-northeast1"

# [optional] Prefix for the Cloud Run services and the runtime service account. With SERVICE_PREFIX="cymbal":
#   cymbal-commerce-mcp     Commerce MCP server            (private)
#   cymbal-adk-agent        ADK AI Concierge agent         (private)
#   cymbal-site             Online store (PC / mobile web) (public)
#   cymbal-store-app        Store app for shoppers         (public)
#   cymbal-store-staff      Staff app (+ /admin manager)   (public)
#   cymbal-data-enrichment  Product Data Enrichment Studio (public)
#   cymbal-runtime@<project>.iam.gserviceaccount.com  runtime service account
SERVICE_PREFIX="cymbal"

# [optional] Runtime service-account name (default: ${SERVICE_PREFIX}-runtime)
RUNTIME_SA_NAME=""

# [optional] BigQuery datasets
BQ_DATASET="cymbal"
ENRICH_BQ_DATASET="cymbal_enrichment"

# [optional] Cloud Storage buckets (empty = derived from PROJECT_ID)
#   CATALOG_BUCKET      default ${PROJECT_ID}-catalog        (catalog import files)
#   STORE_NAVI_BUCKET   default ${PROJECT_ID}-store-navi     (staff shelf photos)
#   ENRICH_IMAGE_BUCKET default products_images_${PROJECT_ID} (Enrichment Studio images)
CATALOG_BUCKET=""
STORE_NAVI_BUCKET=""
ENRICH_IMAGE_BUCKET=""

# [optional] Gemini models on Vertex AI (location "global"). Empty = demo defaults
# (gemini-3-flash-preview / gemini-3.5-flash / gemini-3.8-flash / gemini-3.1-flash-image). Step 15_models checks
# that they answer in your project and records working fallbacks in install/.state/models.env if they do not.
GEMINI_MODEL=""          # search query understanding, store app helpers
AGENT_MODEL=""           # ADK AI Concierge + store app "Ask AI"
ENRICH_GEMINI_MODEL=""   # Enrichment Studio attribute extraction
IMAGE_MODEL=""           # Enrichment Studio image generation
GEMINI_LOCATION="global"

# [optional] Voice conversation in the online store concierge (1 = on, 0 = off)
VOICE_ENABLED="1"
