# Cymbal Data Enrichment Studio (70_data_enrichment) environment variables.
# Copy to .env in this directory (read by pydantic-settings in app/config.py) or export them before running.
# Values below are placeholders/defaults — never commit real project ids. The shared repo config.env provides
# PROJECT_ID / PROJECT_NUMBER / REGION and the *_URL values.

# ── Project & BigQuery ────────────────────────────────────────────────
PROJECT_ID=your-gcp-project-id            # falls back to GOOGLE_CLOUD_PROJECT
ENRICH_BQ_DATASET=cymbal_enrichment       # enrichment results dataset (must differ from the source dataset)
BQ_SOURCE_DATASET=cymbal                  # source catalog dataset
BQ_SOURCE_TABLE_NAME=products             # source catalog table
# BQ_SOURCE_TABLE=your-gcp-project-id.cymbal.products   # optional full override (default ${PROJECT_ID}.cymbal.products)
BQ_LOCATION=asia-northeast1

# ── Gemini text models (Vertex AI) ────────────────────────────────────
ENRICH_GEMINI_MODEL=gemini-3.8-flash      # default live model (UI can pick any probed Gemini 3.x+ model)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash    # used when the primary model is busy (429/503)
VERTEX_LOCATION=global
THINKING_LEVEL=LOW                        # MINIMAL | LOW | MEDIUM | HIGH | "" (model default)

# ── Batch prediction ──────────────────────────────────────────────────
ENRICH_BATCH_MODEL=gemini-3.8-flash
BATCH_LOCATION=global
BATCH_GCS_PREFIX=_batch

# ── Governance & cost display ─────────────────────────────────────────
AUTO_APPROVE_THRESHOLD=0.90
USD_JPY=150                               # FX rate for the JPY reference next to USD costs

# ── Images & documents ────────────────────────────────────────────────
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_MODEL_PRO=gemini-3-pro-image
IMAGE_MODEL_FALLBACK=gemini-2.5-flash-image
IMAGE_BUCKET=                             # default products_images_${PROJECT_ID}
DOCS_PREFIX=_docs_uploads
IMAGE_DEFAULT_SIZE=600
IMAGE_FIDELITY_THRESHOLD=0.7
PUBLIC_BASE_URL=                          # public base URL for image URIs written to the source catalog
UPDATE_AICS=true                          # allow writes to the source catalog (UI checkbox still defaults to OFF)

# ── Cross links ───────────────────────────────────────────────────────
STORE_URL=                                # storefront URL for the header link, e.g. ${ONLINE_STORE_URL} from config.env

# ── Local / tests ─────────────────────────────────────────────────────
OFFLINE=false                             # true = in-memory demo data, no GCP calls
# LOCAL_GCS_DIR=/tmp/aics_local_gcs       # local GCS emulation directory (offline)

# ── Cloud Run (deploy.sh) ─────────────────────────────────────────────
REGION=asia-northeast1
ENRICH_SERVICE=cymbal-data-enrichment
