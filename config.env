# shellcheck shell=bash
# ==============================================================================
# config.env — derived runtime configuration (sourced by install/*.sh and every */deploy.sh)
# ------------------------------------------------------------------------------
# DO NOT put your settings here. Copy install/config.example.env to install/config.env and edit that.
# Everything below is derived from install/config.env (or from already-exported environment variables,
# which always win), so no project id / project number / URL is hard-coded anywhere in this repository.
# ==============================================================================
_CYMBAL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CYMBAL_ROOT="${_CYMBAL_ROOT}"
export PATH="$HOME/google-cloud-sdk/bin:$PATH"
export CLOUDSDK_CORE_DISABLE_PROMPTS=1

# 1) user settings (install/config.env or $CYMBAL_CONFIG). Exported env vars take precedence over the file.
_cymbal_cfg="${CYMBAL_CONFIG:-${_CYMBAL_ROOT}/install/config.env}"
if [[ -f "${_cymbal_cfg}" ]]; then
  _cymbal_keep=()
  while IFS= read -r _k; do   # remember non-empty values the caller already set for keys defined in the file
    [[ -n "${!_k:-}" ]] && _cymbal_keep+=("${_k}=${!_k}")
  done < <(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=.*/\2/p' "${_cymbal_cfg}")
  set -a
  # shellcheck disable=SC1090
  source "${_cymbal_cfg}"
  set +a
  for _kv in "${_cymbal_keep[@]}"; do export "${_kv%%=*}=${_kv#*=}"; done   # caller values win
  unset _cymbal_keep _k _kv
fi
unset _cymbal_cfg

: "${PROJECT_ID:?PROJECT_ID is not set (edit install/config.env or export PROJECT_ID)}"
export PROJECT_ID
export REGION="${REGION:-asia-northeast1}"
export SERVICE_PREFIX="${SERVICE_PREFIX:-cymbal}"

# 2) project number (needed for deterministic Cloud Run URLs) — looked up once and cached per project.
if [[ -z "${PROJECT_NUMBER:-}" ]]; then
  _pn_cache="${_CYMBAL_ROOT}/install/.state/project_number.${PROJECT_ID}"
  if [[ -s "${_pn_cache}" ]]; then
    PROJECT_NUMBER="$(cat "${_pn_cache}")"
  else
    PROJECT_NUMBER="$(gcloud projects describe "${PROJECT_ID}" --format='value(projectNumber)' 2>/dev/null || true)"
    if [[ -n "${PROJECT_NUMBER}" ]]; then
      mkdir -p "$(dirname "${_pn_cache}")" && printf '%s' "${PROJECT_NUMBER}" > "${_pn_cache}"
    fi
  fi
  unset _pn_cache
fi
export PROJECT_NUMBER="${PROJECT_NUMBER:-}"

# 3) data locations
export BQ_DATASET="${BQ_DATASET:-cymbal}"
export BQ_TABLE="${BQ_TABLE:-products}"
export BQ_LOCATION="${BQ_LOCATION:-${REGION}}"
export ENRICH_BQ_DATASET="${ENRICH_BQ_DATASET:-cymbal_enrichment}"
export GCS_BUCKET="${GCS_BUCKET:-${CATALOG_BUCKET:-${PROJECT_ID}-catalog}}"
export CATALOG_BUCKET="${GCS_BUCKET}"
export PHOTO_BUCKET="${PHOTO_BUCKET:-${STORE_NAVI_BUCKET:-${PROJECT_ID}-store-navi}}"
export IMAGE_BUCKET="${IMAGE_BUCKET:-${ENRICH_IMAGE_BUCKET:-products_images_${PROJECT_ID}}}"
export LANGUAGE_CODE="en"
export CURRENCY_CODE="${CURRENCY_CODE:-JPY}"

# 4) runtime service account
export RUNTIME_SA_NAME="${RUNTIME_SA_NAME:-${SERVICE_PREFIX}-runtime}"
export RUNTIME_SA="${RUNTIME_SA:-${RUNTIME_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com}"

# 5) Cloud Run services (deterministic URLs: https://<service>-<project number>.<region>.run.app)
export SITE_SERVICE="${SITE_SERVICE:-${SERVICE_PREFIX}-site}"
export ADK_SERVICE="${ADK_SERVICE:-${SERVICE_PREFIX}-adk-agent}"
export MCP_SERVICE="${MCP_SERVICE:-${SERVICE_PREFIX}-commerce-mcp}"
export STORE_APP_SERVICE="${STORE_APP_SERVICE:-${SERVICE_PREFIX}-store-app}"
export STAFF_SERVICE="${STAFF_SERVICE:-${SERVICE_PREFIX}-store-staff}"
export ENRICH_SERVICE="${ENRICH_SERVICE:-${SERVICE_PREFIX}-data-enrichment}"
export RUN_SUFFIX="${PROJECT_NUMBER}.${REGION}.run.app"
export SITE_BASE_URL="${SITE_BASE_URL:-https://${SITE_SERVICE}-${RUN_SUFFIX}}"
export STORE_APP_URL="${STORE_APP_URL:-https://${STORE_APP_SERVICE}-${RUN_SUFFIX}}"
export STAFF_URL="${STAFF_URL:-https://${STAFF_SERVICE}-${RUN_SUFFIX}}"
export ENRICH_URL="${ENRICH_URL:-https://${ENRICH_SERVICE}-${RUN_SUFFIX}}"
export ONLINE_STORE_URL="${ONLINE_STORE_URL:-${SITE_BASE_URL}}"

# 6) models (install step 15_models verifies them and may write fallbacks to install/.state/models.env)
if [[ -f "${_CYMBAL_ROOT}/install/.state/models.env" ]]; then
  # shellcheck disable=SC1091
  source "${_CYMBAL_ROOT}/install/.state/models.env"
fi
_cymbal_model() {  # $1=var $2=demo default — a probed fallback replaces the default only when the default did not answer
  local var="$1" def="$2" probed="PROBED_$1"
  local val="${!var:-${def}}"
  [[ "${val}" == "${def}" && -n "${!probed:-}" ]] && val="${!probed}"
  export "${var}=${val}"
}
_cymbal_model GEMINI_MODEL gemini-3-flash-preview
_cymbal_model AGENT_MODEL gemini-3.5-flash
_cymbal_model ENRICH_GEMINI_MODEL gemini-3.8-flash
_cymbal_model GEMINI_FALLBACK_MODEL gemini-3.5-flash
_cymbal_model IMAGE_MODEL gemini-3.1-flash-image
unset -f _cymbal_model
export GEMINI_LOCATION="${GEMINI_LOCATION:-global}"
export VOICE_ENABLED="${VOICE_ENABLED:-1}"

# 7) seed files rendered for this project (URLs rewritten by install/lib/render_seed.py)
export SEED_DIR="${_CYMBAL_ROOT}/seed"
export RENDERED_DIR="${RENDERED_DIR:-${_CYMBAL_ROOT}/install/.state/rendered}"
if [[ -n "${PROJECT_NUMBER}" && "${CYMBAL_SKIP_RENDER:-0}" != "1" ]]; then
  _stamp="${RENDERED_DIR}/.stamp"
  _want="${PROJECT_ID}|${PROJECT_NUMBER}|${REGION}|${SERVICE_PREFIX}|${SITE_BASE_URL}|${STORE_APP_URL}|${STAFF_URL}|${ENRICH_URL}"
  if [[ ! -f "${_stamp}" || "$(cat "${_stamp}" 2>/dev/null)" != "${_want}" || "${SEED_DIR}/catalog/products_retail.jsonl" -nt "${_stamp}" ]]; then
    python3 "${_CYMBAL_ROOT}/install/lib/render_seed.py" --catalog-only >&2 || echo "WARN: render_seed.py failed" >&2
  fi
  unset _stamp _want
fi
export CATALOG_JSONL="${CATALOG_JSONL:-${RENDERED_DIR}/catalog/products_retail.jsonl}"
export AUTOCOMPLETE_JSONL="${AUTOCOMPLETE_JSONL:-${RENDERED_DIR}/catalog/autocomplete_suggestions.jsonl}"
unset _CYMBAL_ROOT
